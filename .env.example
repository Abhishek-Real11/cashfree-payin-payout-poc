PORT=5052
CASHFREE_ENV=sandbox
# Payment Gateway test App ID and Secret Key (used for Pay-in).
CASHFREE_CLIENT_ID=your_sandbox_app_id
CASHFREE_CLIENT_SECRET=your_sandbox_secret
# Payouts uses its own Client ID and Client Secret from Payouts > Developers.
# CASHFREE_PAYOUT_CLIENT_ID=your_sandbox_payout_client_id
# CASHFREE_PAYOUT_CLIENT_SECRET=your_sandbox_payout_secret
# Set this to true to enable payout API calls while testing with sandbox credentials.
ENABLE_SANDBOX_PAYOUTS=false
APP_BASE_URL=http://localhost:5052
